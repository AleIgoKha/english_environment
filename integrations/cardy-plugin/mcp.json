{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cardy": {
      "type": "streamable-http",
      "url": "https://english-environment-production.up.railway.app/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["cards:read"],
            "defaultScopes": ["cards:read", "cards:add"]
          }
        }
      }
    }
  }
}
