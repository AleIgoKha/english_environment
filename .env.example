# Examples only. Run scripts/setup_local.py to generate your ignored local .env.
DJANGO_DEBUG=true
LOCAL_DEV_ADDRESS=127.0.0.1:8000
# For Wi-Fi testing, bind 0.0.0.0:8000, add the computer's LAN IP to
# DJANGO_ALLOWED_HOSTS, and set the private subnet below in your ignored .env.
LOCAL_DEV_URL=http://127.0.0.1:8000/
LOCAL_TEST_NETWORK=
DJANGO_SECRET_KEY=replace-with-a-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAIL=owner@example.com
# Optional read-only MCP access. Leave empty to disable. Store the SHA-256
# digest here; keep the original random bearer token only in client secrets.
CARDY_MCP_TOKEN_SHA256=
# Separate opt-in add-cards credential. Read credentials cannot add cards.
CARDY_MCP_WRITE_TOKEN_SHA256=
# Local test login uses a separate SQLite deck. Never enable on Railway.
DJANGO_LOCAL_TEST_LOGIN=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
